{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "forceExit": true,
  "moduleNameMapper": {
    "^jose$": "<rootDir>/__mocks__/jose.js",
    "^@treaty/shared$": "<rootDir>/../../packages/shared/src"
  }
}
